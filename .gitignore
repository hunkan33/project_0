# =====================================================================
#  .gitignore —— 本仓库只收「源码 + 工程文件 + 脚本 + 文档源」
#  取舍依据：AGENT.md 二（提交与门禁）
#    · 生成物、历史备份、外部资料不入库；克隆后跑 scripts/build.sh 即可重建
#    · third_party/（9.3M）与 参考/（24M）由环境提供，不入库
# =====================================================================

# ---- 编译产物 ----
build/
*.o
*.a
*.so
moc_*.cpp
moc_*.h
qrc_*.cpp
Makefile
.qmake.stash

# ---- 生成物 ----
docs/doxygen/
*.raw
*.log

# ---- 测试程序的编译产物 ----
# tests/<名字>/ 下的可执行文件与所在目录同名、无扩展名（qmake 默认 TARGET=目录名）。
# 用「无扩展名」判定而不是逐个列名字：以后新增测试目录不用回来改规则。
/tests/*/*
!/tests/*/*.*
!/tests/*/Makefile
# ★ 上面那条「有扩展名就放行」会连 .o 一起放行，所以这里要盖回来。
#   gitignore 是「后面的规则覆盖前面」，顺序不能调。
/tests/*/*.o

# ---- 备份（backup.py 产物：源码的历史快照）----
备份/

# ---- 外部资料与第三方 ----
参考/
third_party/

# ---- Python ----
__pycache__/
*.pyc

# ---- 编辑器 / 系统 ----
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
